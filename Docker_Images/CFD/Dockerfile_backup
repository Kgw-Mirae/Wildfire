# 1. Rocky Linux 9 베이스 이미지 지정
FROM rockylinux:9

# 2. 필요한 패키지 설치 (Ubuntu의 apt-get 대신 dnf를 사용합니다)
RUN dnf update -y && \
    dnf install -y dnf-plugins-core epel-release && \
    dnf config-manager --set-enabled crb && \
    dnf install -y python3 python3-pip wget tar openmpi-devel && \
    dnf install -y gcc gcc-gfortran make tcsh ksh perl libgfortran && \
    dnf install -y netcdf-devel netcdf-fortran-devel pkgconf-pkg-config  && \
    dnf clean all

RUN pip install --no-cache-dir numpy pandas geopandas rasterio

# 3. 컨테이너 내부의 작업 디렉토리 설정
WORKDIR /app

# 4. 현재 폴더의 쉘 스크립트를 포함한 모든 파일을 컨테이너로 복사
COPY . /app
COPY wgrib2 /usr/local/bin/wgrib2

RUN chmod +x /usr/local/bin/wgrib2

ENV PATH="/usr/lib64/openmpi/bin:${PATH}"
ENV LD_LIBRARY_PATH="/usr/lib64/openmpi/lib:${LD_LIBRARY_PATH:-}"

ENV OMPI_ALLOW_RUN_AS_ROOT=1
ENV OMPI_ALLOW_RUN_AS_ROOT_CONFIRM=1

# 5. 컨테이너가 시작될 때 실행할 스크립트 지정
#CMD ["./run_script.sh"]
